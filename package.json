{
  "name": "charmling-desktop",
  "productName": "Charmling",
  "version": "1.0.0",
  "description": "Charmling for Windows Desktop — A cute lucky charm with real elastic cord physics, lore vitrine, wander mode, and quiet focus tools",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "start": "electron .",
    "build": "vite build",
    "package:dir": "vite build && electron-builder --dir",
    "package:portable": "vite build && electron-builder --win portable",
    "package:win": "vite build && electron-builder --win nsis",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "app.charmling.desktop",
    "productName": "Charmling",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Charmling"
    }
  },
  "keywords": [
    "charmling",
    "desktop-pet",
    "physics",
    "focus-timer",
    "windows-desktop"
  ],
  "author": "Charmling",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
